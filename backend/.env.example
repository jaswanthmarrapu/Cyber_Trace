# CyberTrace Forensics Platform - Environment Configuration Template

# Runtime Mode: 'development' or 'production'
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Project Metadata
PROJECT_NAME="CyberTrace – Digital Forensics Platform"
VERSION="1.0.0"

# Persistent Storage & Database
# On Render or Docker, point DATA_DIR to your mounted persistent volume (e.g., /var/data)
DATA_DIR=/var/data
DATABASE_URL=sqlite:////var/data/cybertrace.db

# Cryptographic Security & JWT (Generate a unique 32+ char random string for production)
SECRET_KEY=replace-with-a-high-entropy-64-character-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Examiner Account (Set your own secure credentials for the first run)
ADMIN_INITIAL_USERNAME=admin_examiner
ADMIN_INITIAL_PASSWORD=SetYourOwnSecurePass2026!
ADMIN_INITIAL_EMAIL=examiner@cybertrace.local

# Evidence Vault Security
MAX_UPLOAD_SIZE_BYTES=52428800

# CORS Whitelist (comma-separated origins allowed to communicate with this API)
CORS_ORIGINS=https://cyber-trace-gamma.vercel.app,http://localhost:5173,http://localhost:5174
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
